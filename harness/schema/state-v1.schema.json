{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flight505/flight505-harness/schema/state-v1.schema.json",
  "title": "Harness State Contract v1",
  "description": "Shared state envelope written by every harness plugin to .harness/",
  "type": "object",
  "required": [
    "schema",
    "workflow_id",
    "phase_id",
    "plugin",
    "run_id",
    "status",
    "started_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "harness/v1",
      "description": "Schema version identifier"
    },
    "workflow_id": {
      "type": "string",
      "description": "ID of the parent workflow (from workflow.yaml name field)"
    },
    "phase_id": {
      "type": "string",
      "description": "ID of this phase within the workflow"
    },
    "plugin": {
      "type": "string",
      "const": "harness",
      "description": "Plugin owning this state (always 'harness' since consolidation)"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this run (e.g., build-001, opt-003)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "skipped",
        "cancelled",
        "waiting_approval"
      ],
      "description": "Current phase status"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this phase started"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last state update"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Wall-clock seconds since phase started"
    },
    "current_experiment_description": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Short description of the currently running experiment (e.g., 'lr 1e-3 → 3e-4'). Set before each run, cleared on completion."
    },
    "team_name": {
      "type": "string",
      "description": "For agent-teams phases: the team name used by Claude Code's native Agent Teams feature. Mirrors ~/.claude/teams/{team_name}/config.json. Null or absent for non-team phases."
    },
    "teammates": {
      "type": "array",
      "description": "For agent-teams phases: list of active teammates in the team. Updated by the TeammateIdle hook.",
      "items": {
        "type": "object",
        "required": ["name", "agent_type", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Teammate name assigned by the lead at spawn time"
          },
          "agent_type": {
            "type": "string",
            "description": "Subagent definition used as the teammate role (e.g., implementer, reviewer)"
          },
          "status": {
            "type": "string",
            "enum": ["working", "idle", "stopped"],
            "description": "Current teammate state"
          },
          "tasks_completed": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of tasks this teammate has completed"
          }
        },
        "additionalProperties": false
      }
    },
    "progress": {
      "type": "object",
      "description": "Optional progress tracking",
      "required": ["current", "total", "unit"],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "description": "What is being counted (experiments, stories, papers, etc.)"
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "description": "Tracked metric for optimization phases",
      "required": ["name", "direction", "baseline", "current"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Metric name (e.g., val_bpb, p99_latency_ms)"
        },
        "direction": {
          "type": "string",
          "enum": ["lower", "higher"],
          "description": "Whether lower or higher values are better"
        },
        "baseline": {
          "type": "number",
          "description": "Initial metric value before optimization"
        },
        "current": {
          "type": "number",
          "description": "Most recent metric value"
        },
        "best": {
          "type": "number",
          "description": "Best metric value achieved so far"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["experiment", "value", "status"],
            "properties": {
              "experiment": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "type": "number"
              },
              "status": {
                "type": "string",
                "enum": ["baseline", "kept", "reverted", "running"]
              },
              "description": {
                "type": "string",
                "description": "Brief description of what was changed"
              },
              "commit_sha": {
                "type": "string",
                "description": "Full git SHA of the commit produced by this experiment. For 'kept' entries this is the experiment commit; for 'reverted' entries it is the revert commit. Optional — only present when the run is git-tracked and the agent captured it."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "description": "Plugin-specific output data. Shape varies by plugin.",
      "additionalProperties": true
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "code": {
              "type": "string",
              "description": "Machine-readable error code"
            },
            "phase_id": {
              "type": "string",
              "description": "Which phase failed (for conductor-level errors)"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Error details if status is 'failed', null otherwise"
    },
    "config": {
      "type": "object",
      "description": "Snapshot of the config used for this phase (from workflow.yaml)",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
