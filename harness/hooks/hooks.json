{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "_comment": "Inject current workflow progress into session context.",
        "hooks": [
          {
            "type": "command",
            "command": "'${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' inject-status"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "_comment": "Inject configured hardware targets into session context. Re-injects on resume/clear/compact so hardware awareness survives compaction.",
        "hooks": [
          {
            "type": "command",
            "command": "'${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' inject-targets"
          }
        ]
      }
    ],
    "Notification": [
      {
        "_comment": "Desktop notification when Claude finishes work or needs input. Cross-platform.",
        "hooks": [
          {
            "type": "command",
            "command": "'${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' notify-complete"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "_comment": "After each Bash call during optimization, validate that metric was parseable if this was an experiment run.",
        "hooks": [
          {
            "type": "command",
            "command": "'${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd' validate-experiment"
          }
        ]
      },
      {
        "_comment": "Validates research agent output structure after .harness/research-*.json writes.",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/validate-research-output.mjs",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "_comment": "Before context compaction, flush optimizer state summary to stdout so baseline/best/recent-history survive the compaction summary.",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/on-pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/on-task-created.sh",
            "timeout": 5,
            "statusMessage": "Validating task..."
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/on-task-completed.sh",
            "timeout": 180,
            "statusMessage": "Validating and recording task completion..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/validate-fix.sh",
            "timeout": 120,
            "statusMessage": "Validating fix..."
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/on-teammate-idle.sh",
            "timeout": 10,
            "statusMessage": "Checking team progress..."
          }
        ]
      }
    ]
  }
}
